{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[0-9a-f]{32}$/) && data.child('expiresAt').val() > now",
        ".write": "auth != null && $room.matches(/^[0-9a-f]{32}$/) && ((!data.exists() && newData.child('owner').val() == auth.uid && newData.child('expiresAt').val() > now) || (data.child('owner').val() == auth.uid && !newData.exists()))",
        "owner": {
          ".validate": "newData.isString()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "signals": {
          "$signalId": {
            ".write": "auth != null && $room.matches(/^[0-9a-f]{32}$/) && root.child('rooms').child($room).child('expiresAt').val() > now && !data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['from', 'type', 'data']) && (newData.child('from').val() == 'viewer' || newData.child('from').val() == 'camera') && (newData.child('type').val() == 'description' || newData.child('type').val() == 'ice' || newData.child('type').val() == 'bye') && (newData.child('type').val() == 'bye' || (newData.child('type').val() == 'description' && newData.child('data').hasChildren(['type', 'sdp']) && newData.child('data').child('sdp').isString()) || (newData.child('type').val() == 'ice' && newData.child('data').child('candidate').isString()))"
          }
        }
      }
    }
  }
}
